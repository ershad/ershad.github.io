---
layout: null
permalink: /posts/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | append: ' — Writing' | xml_escape }}</title>
    <link>{{ '/posts/' | absolute_url | xml_escape }}</link>
    <description>Notes and essays by {{ site.name | xml_escape }}.</description>
    <language>{{ site.locale | xml_escape }}</language>
    <atom:link href="{{ '/posts/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml"/>
    {% assign articles = site.writing | sort: 'date' | reverse %}
    {% for post in articles limit:20 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url | xml_escape }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.description | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
